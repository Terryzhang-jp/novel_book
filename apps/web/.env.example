# Supabase Configuration (必需)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase PostgreSQL 直连 (用于 Better Auth)
# 格式: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=your-supabase-postgres-connection-string

# Better Auth (认证系统)
# 生成密钥: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (用于 Google 登录)
# 在 Google Cloud Console 创建 OAuth 2.0 凭据
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# [已废弃] JWT Secret - 已迁移到 Better Auth
# JWT_SECRET=your-secret-key-change-in-production-min-32-chars

# OpenAI API Key (用于 AI 功能)
OPENAI_API_KEY=

# 可选：Vercel Blob (用于图片存储)
BLOB_READ_WRITE_TOKEN=

# 可选：Vercel KV (用于限流)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Map Provider Configuration (地图提供商配置)
# Options: 'leaflet' (default, free), 'mapbox', 'google'
# leaflet: OpenStreetMap + Leaflet (免费,无需API密钥)
# mapbox: Mapbox (需要API密钥, 未来实现)
# google: Google Maps (需要API密钥, 未来实现)
NEXT_PUBLIC_MAP_PROVIDER=leaflet

# Mapbox API Key (如果使用 Mapbox)
NEXT_PUBLIC_MAPBOX_API_KEY=

# Google Maps API Key (如果使用 Google Maps)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
