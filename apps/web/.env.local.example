# ============================================================================
# 本地开发环境变量
# ============================================================================
#
# 用法：
#   cp .env.local.example .env.local
#   pnpm db:start          # 启动本地 Supabase（需要 Docker Desktop 运行中）
#   pnpm dev
#
# 下面的 Supabase 值是 CLI 本地环境的**固定默认值** —— 对所有人、所有机器
# 都一样，只对 127.0.0.1 有效，因此可以安全提交进仓库。
# `pnpm db:start` 启动后会打印同样的值，可以对照。
# ============================================================================

# ── Supabase（本地）────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# 本地 CLI 的固定 demo key（官方公开值，非机密）
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ── Postgres 直连（Better Auth 用）─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Better Auth ────────────────────────────────────────────────────────────
# 本地固定值即可；生产必须换成 `openssl rand -base64 32`
BETTER_AUTH_SECRET=local-dev-only-secret-do-not-use-in-production-32
BETTER_AUTH_URL=http://127.0.0.1:3000
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# ── 可选：AI 能力（不填则相关接口返回 500，其余功能正常）──────────────────
# 这些接口现在都要求登录 + 限流，见 lib/api/guard.ts
GOOGLE_GENAI_API_KEY=
OPENAI_API_KEY=

# ── 可选：Google OAuth ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 可选：照片语义向量（Vertex AI）────────────────────────────────────────
# ⚠️ 当前凭据方案在 Vercel 上不可用：代码先试 GCP metadata 服务器（Vercel
#    上不存在），再回退 GOOGLE_ACCESS_TOKEN（gcloud 生成，1 小时过期）。
#    生产需改成 Service Account。
GOOGLE_CLOUD_PROJECT=
VERTEX_AI_REGION=us-central1
GOOGLE_ACCESS_TOKEN=

# ── 地图 ───────────────────────────────────────────────────────────────────
# 目前只有 leaflet 有实现；mapbox / google 的 provider 是空壳
NEXT_PUBLIC_MAP_PROVIDER=leaflet
